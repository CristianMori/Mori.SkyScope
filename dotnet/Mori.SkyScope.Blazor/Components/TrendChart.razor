@* Mori.SkyScope — Razor component hosting the trend chart: configuration as JSON over interop, data streamed in the browser. Author: Cristian Mori. Copyright 2026 Cristian Mori. Licensed under the Apache License, Version 2.0. *@

@namespace Mori.SkyScope.Blazor
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_host" class="@Css.Classes("skyscope-trend-host", Class)" style="@($"width:100%;height:{Height};min-height:120px;{Style}")" @attributes="AdditionalAttributes"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private string? _lastConfigJson;
    private DotNetObjectReference<TrendChart>? _self;

    /// <summary>The JS handle, for sibling components (the <see cref="SignalTree"/> attaches to it).</summary>
    internal IJSObjectReference? Handle => _handle;
    /// <summary>Raised once the JS side is mounted.</summary>
    internal event Action? Mounted;

    /// <summary>SkyScopeFrame stream (ws:// or wss://). Charts on one page sharing a URL share one socket.</summary>
    [Parameter] public string? WsUrl { get; set; }
    /// <summary>Chart configuration; serialised to the same JSON shape the TS engine reads.</summary>
    [Parameter] public Core.Charts.TrendChartConfig? Config { get; set; }
    /// <summary>Pointer tool applied when the chart mounts; use <see cref="SetToolAsync"/> to change it afterwards.</summary>
    [Parameter] public Core.Scene.Tool Tool { get; set; } = Core.Scene.Tool.Pan;
    /// <summary>Draw series with WebGL when the browser supports it; false forces the 2D canvas renderer.</summary>
    [Parameter] public bool WebGL { get; set; } = true;
    /// <summary>Seconds of history the browser-side store keeps per channel.</summary>
    [Parameter] public double RetentionSeconds { get; set; } = 60;
    /// <summary>CSS height of the host element (the width is always 100%).</summary>
    [Parameter] public string Height { get; set; } = "360px";
    /// <summary>Extra CSS classes for the host element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Extra inline CSS appended to the host element's style.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>Unmatched attributes, forwarded to the host element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>
    /// Channels dropped on the chart (HTML5 drag and drop from a <see cref="SignalTree"/> or any element carrying the channel
    /// payload), before they are added: set <see cref="Core.Charts.ChannelDropEventArgs.Cancel"/> to refuse, replace the target to
    /// redirect, or add the signals yourself with <see cref="AddChannelsAsync"/> and set <c>Handled</c>. Without a handler the chart
    /// adds them by its drop rules.
    /// </summary>
    [Parameter] public Func<Core.Charts.ChannelDropEventArgs, Task>? OnChannelDrop { get; set; }

    private static string ToolName(Core.Scene.Tool t) => t switch { Core.Scene.Tool.BoxZoom => "boxZoom", Core.Scene.Tool.Cursor => "cursor", Core.Scene.Tool.Select => "select", _ => "pan" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Mori.SkyScope.Blazor/skyscope.js");
            _lastConfigJson = Config is null ? null : TrendChartJson.Serialize(Config);
            _handle = await _module.InvokeAsync<IJSObjectReference>("mountTrendChart", _host,
                new { wsUrl = WsUrl, configJson = _lastConfigJson, tool = ToolName(Tool), webgl = WebGL, retentionSeconds = RetentionSeconds });
            if (OnChannelDrop is not null) { _self = DotNetObjectReference.Create(this); await _handle.InvokeVoidAsync("setDropHandler", _self); }
            Mounted?.Invoke();
            return;
        }
        if (_handle is null) return;
        var json = Config is null ? null : TrendChartJson.Serialize(Config);
        if (json is not null && json != _lastConfigJson) { _lastConfigJson = json; await _handle.InvokeVoidAsync("setConfig", json); }
    }

    /// <summary>Freeze the time window; data keeps arriving in the store.</summary>
    public ValueTask PauseAsync() => _handle?.InvokeVoidAsync("pause") ?? ValueTask.CompletedTask;
    /// <summary>Follow live time again after <see cref="PauseAsync"/>.</summary>
    public ValueTask ResumeAsync() => _handle?.InvokeVoidAsync("resume") ?? ValueTask.CompletedTask;
    /// <summary>Reset the view: back to live time with the configured time span.</summary>
    public ValueTask ResetAsync() => _handle?.InvokeVoidAsync("reset") ?? ValueTask.CompletedTask;
    /// <summary>Set the visible time window in seconds.</summary>
    public ValueTask SetTimeSpanAsync(double seconds) => _handle?.InvokeVoidAsync("setTimeSpan", seconds) ?? ValueTask.CompletedTask;
    /// <summary>Switch the pointer tool.</summary>
    public ValueTask SetToolAsync(Core.Scene.Tool tool) => _handle?.InvokeVoidAsync("setTool", ToolName(tool)) ?? ValueTask.CompletedTask;
    /// <summary>The arrangement as a JSON layout file (theme and style excluded).</summary>
    public ValueTask<string> ExportLayoutAsync() => _handle?.InvokeAsync<string>("exportLayout") ?? ValueTask.FromResult("");
    /// <summary>Replace the arrangement with a layout file; theme and style are kept.</summary>
    public ValueTask ImportLayoutAsync(string json) => _handle?.InvokeVoidAsync("importLayout", json) ?? ValueTask.CompletedTask;
    /// <summary>Let the browser download the layout file under <paramref name="fileName"/>.</summary>
    public ValueTask DownloadLayoutAsync(string fileName = "layout.json") => _handle?.InvokeVoidAsync("downloadLayout", fileName) ?? ValueTask.CompletedTask;
    /// <summary>Let the browser download the visible signals between cursors A and B as <c>"csv"</c> or <c>"mcap"</c>; false, nothing saved, unless both cursors are set.</summary>
    public ValueTask<bool> ExportCursorsAsync(string format = "csv") => _handle?.InvokeAsync<bool>("exportCursors", format) ?? ValueTask.FromResult(false);
    /// <summary>
    /// Add channels from code: a series per channel not in the chart yet, placed at <paramref name="target"/> with the drop rules
    /// (default: the first lane, analog on an own axis, digital in the logic stack). Returns the series ids.
    /// </summary>
    public async ValueTask<IReadOnlyList<string>> AddChannelsAsync(IReadOnlyList<int> channelIds, Core.Charts.DropTarget? target = null, bool group = false)
        => _handle is null ? [] : await _handle.InvokeAsync<string[]>("addChannels", channelIds, target is null ? null : TrendChartJson.SerializeLoose(DropTargetJson.ToJson(target)), group);

    /// <summary>Called from the browser on a drop; runs <see cref="OnChannelDrop"/> and answers with the verdict.</summary>
    [JSInvokable("OnChannelDrop")]
    public async Task<string> HandleChannelDropAsync(string json)
    {
        if (OnChannelDrop is null) return "apply";
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;
        var channels = root.GetProperty("channels").EnumerateArray().Select(c => new Core.Charts.ChannelDragItem(c.GetProperty("id").GetInt32(),
            c.TryGetProperty("name", out var n) && n.ValueKind == System.Text.Json.JsonValueKind.String ? n.GetString() : null,
            c.TryGetProperty("unit", out var u) && u.ValueKind == System.Text.Json.JsonValueKind.String ? u.GetString() : null,
            c.TryGetProperty("kind", out var k) && k.ValueKind == System.Text.Json.JsonValueKind.String ? (k.GetString() == "digital" ? Core.Sources.ChannelKind.Digital : Core.Sources.ChannelKind.Analog) : null)).ToList();
        var group = root.TryGetProperty("group", out var g) && g.ValueKind == System.Text.Json.JsonValueKind.True;
        var args = new Core.Charts.ChannelDropEventArgs(new Core.Charts.ChannelDragPayload(channels, group), DropTargetJson.Parse(root.GetProperty("target")), root.GetProperty("x").GetDouble(), root.GetProperty("y").GetDouble());
        var original = args.Target;
        await OnChannelDrop(args);
        if (args.Cancel) return "cancel";
        if (args.Handled) return "handled";
        if (!ReferenceEquals(original, args.Target) || args.Group != group)
        {
            // the handler redirected the drop: apply it from here with the new target, then tell the browser it is done
            await AddChannelsAsync(args.ChannelIds, args.Target, args.Group);
            return "handled";
        }
        return "apply";
    }

    /// <summary>Disposes the JS chart and the module; a dropped circuit is ignored.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
