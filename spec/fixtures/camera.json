{
  "$schema": "../fixture.schema.json",
  "component": "camera",
  "description": "Camera2D: projection, pan, zoom-at-point, fit, world bounds, rotation, flipY, clamps. Results rounded to 9 decimals.",
  "cases": [
    { "name": "project and unproject with flipY",
      "setup": { "width": 200, "height": 100, "zoom": 10 },
      "steps": [{ "type": "query", "project": [1, 1] }, { "type": "query", "unproject": [110, 40] }, { "type": "query", "project": [0, 0] }],
      "expect": { "version": 0, "queries": [{ "x": 110, "y": 40 }, { "x": 1, "y": 1 }, { "x": 100, "y": 50 }] } },
    { "name": "flipY false maps world y down",
      "setup": { "width": 200, "height": 100, "zoom": 10, "flipY": false },
      "steps": [{ "type": "query", "project": [1, 1] }],
      "expect": { "queries": [{ "x": 110, "y": 60 }] } },
    { "name": "pan drags the content",
      "setup": { "width": 200, "height": 100, "zoom": 10 },
      "steps": [{ "type": "pan", "dx": 20, "dy": 10 }, { "type": "query", "project": [0, 0] }],
      "expect": { "centerX": -2, "centerY": 1, "version": 1, "queries": [{ "x": 120, "y": 60 }] } },
    { "name": "zoomAt keeps the point under the cursor fixed",
      "setup": { "width": 200, "height": 100, "zoom": 10 },
      "steps": [{ "type": "zoomAt", "x": 110, "y": 40, "factor": 2 }, { "type": "query", "project": [1, 1] }],
      "expect": { "zoom": 20, "centerX": 0.5, "centerY": 0.5, "queries": [{ "x": 110, "y": 40 }] } },
    { "name": "fitBounds picks the limiting axis",
      "setup": { "width": 200, "height": 100, "zoom": 1 },
      "steps": [{ "type": "fitBounds", "rect": { "x": 0, "y": 0, "w": 4, "h": 1 } }, { "type": "query", "worldBounds": true }],
      "expect": { "zoom": 50, "centerX": 2, "centerY": 0.5, "queries": [{ "x": 0, "y": -0.5, "w": 4, "h": 2 }] } },
    { "name": "fitBounds with padding",
      "setup": { "width": 200, "height": 100, "zoom": 1 },
      "steps": [{ "type": "fitBounds", "rect": { "x": 0, "y": 0, "w": 4, "h": 1 }, "padding": 10 }],
      "expect": { "zoom": 45 } },
    { "name": "worldBounds of the viewport",
      "setup": { "width": 200, "height": 100, "zoom": 10 },
      "steps": [{ "type": "query", "worldBounds": true }],
      "expect": { "queries": [{ "x": -10, "y": -5, "w": 20, "h": 10 }] } },
    { "name": "fitScreenRect (box zoom)",
      "setup": { "width": 200, "height": 100, "zoom": 10 },
      "steps": [{ "type": "fitScreenRect", "rect": { "x": 50, "y": 25, "w": 100, "h": 50 } }],
      "expect": { "zoom": 20, "centerX": 0, "centerY": 0 } },
    { "name": "rotation turns the world clockwise",
      "setup": { "width": 200, "height": 100, "zoom": 10, "rotation": 1.5707963267948966 },
      "steps": [{ "type": "query", "project": [1, 0] }, { "type": "query", "unproject": [100, 60] }],
      "expect": { "queries": [{ "x": 100, "y": 60 }, { "x": 1, "y": 0 }] } },
    { "name": "fitBounds respects rotation",
      "setup": { "width": 200, "height": 100, "zoom": 1, "rotation": 1.5707963267948966 },
      "steps": [{ "type": "fitBounds", "rect": { "x": 0, "y": 0, "w": 4, "h": 1 } }],
      "expect": { "zoom": 25 } },
    { "name": "zoom is clamped",
      "setup": { "width": 200, "height": 100, "zoom": 10, "minZoom": 0.5, "maxZoom": 100 },
      "steps": [{ "type": "setZoom", "zoom": 0.001 }, { "type": "query", "zoom": true }, { "type": "setZoom", "zoom": 5000 }],
      "expect": { "zoom": 100, "queries": [0.5] } },
    { "name": "setViewport bumps the version only when it changes",
      "setup": { "width": 200, "height": 100 },
      "steps": [{ "type": "setViewport", "width": 200, "height": 100 }, { "type": "setViewport", "width": 300, "height": 100 }, { "type": "query", "project": [0, 0] }],
      "expect": { "version": 1, "queries": [{ "x": 150, "y": 50 }] } }
  ]
}
