{
  "$schema": "../fixture.schema.json",
  "component": "geometry",
  "description": "Affine matrices, rect helpers, segment distance, point-in-polygon. Results rounded to 9 decimals.",
  "cases": [
    { "name": "translation then scaling composes in DOMMatrix order",
      "steps": [{ "type": "query", "apply": [{ "mul": [{ "translation": [10, 20] }, { "scaling": [2, 3] }] }, 1, 1] }],
      "expect": { "queries": [{ "x": 12, "y": 23 }] } },
    { "name": "invert",
      "steps": [{ "type": "query", "invert": { "mul": [{ "translation": [10, 20] }, { "scaling": [2, 3] }] } }, { "type": "query", "invert": { "a": 1, "b": 2, "c": 2, "d": 4, "e": 0, "f": 0 } }],
      "expect": { "queries": [{ "a": 0.5, "b": 0, "c": 0, "d": 0.333333333, "e": -5, "f": -6.666666667 }, null] } },
    { "name": "rotation is clockwise on a y-down screen",
      "steps": [{ "type": "query", "matrix": { "rotation": 1.5707963267948966 } }, { "type": "query", "apply": [{ "rotation": 1.5707963267948966 }, 1, 0] }],
      "expect": { "queries": [{ "a": 0, "b": 1, "c": -1, "d": 0, "e": 0, "f": 0 }, { "x": 0, "y": 1 }] } },
    { "name": "distance to segment",
      "steps": [{ "type": "query", "distToSegment": [0, 1, 0, 0, 2, 0] }, { "type": "query", "distToSegment": [5, 0, 0, 0, 2, 0] }, { "type": "query", "distToSegment": [3, 4, 0, 0, 0, 0] }, { "type": "query", "distToSegment": [1, 1, 0, 0, 2, 2] }],
      "expect": { "queries": [1, 3, 5, 0] } },
    { "name": "point in polygon",
      "steps": [{ "type": "query", "pointInPolygon": [1, 1, [0, 0, 4, 0, 4, 4, 0, 4]] }, { "type": "query", "pointInPolygon": [5, 1, [0, 0, 4, 0, 4, 4, 0, 4]] }, { "type": "query", "pointInPolygon": [2, 1, [0, 0, 4, 0, 2, 3]] }, { "type": "query", "pointInPolygon": [0.5, 2, [0, 0, 4, 0, 2, 3]] }],
      "expect": { "queries": [true, false, true, false] } },
    { "name": "rect helpers",
      "steps": [{ "type": "query", "rectFromPoints": [3, 1, -1, 4, 2, 2] }, { "type": "query", "rectFromPoints": [] }, { "type": "query", "rectUnion": [{ "x": 0, "y": 0, "w": 1, "h": 1 }, { "x": 2, "y": -1, "w": 1, "h": 1 }] }, { "type": "query", "rectUnion": [null, { "x": 2, "y": -1, "w": 1, "h": 1 }] }, { "type": "query", "rectNormalize": [5, 5, 1, 2] }],
      "expect": { "queries": [{ "x": -1, "y": 1, "w": 4, "h": 3 }, null, { "x": 0, "y": -1, "w": 3, "h": 2 }, { "x": 2, "y": -1, "w": 1, "h": 1 }, { "x": 1, "y": 2, "w": 4, "h": 3 }] } },
    { "name": "transformRect is the AABB of the transformed corners",
      "steps": [{ "type": "query", "transformRect": [{ "rotation": 1.5707963267948966 }, { "x": 0, "y": 0, "w": 4, "h": 2 }] }],
      "expect": { "queries": [{ "x": -2, "y": 0, "w": 2, "h": 4 }] } }
  ]
}
