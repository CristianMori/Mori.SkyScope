    {
      "name": "time: sub-second ticks on a unix epoch with fractional labels",
      "setup": {
        "kind": "time",
        "domain": [
          1700000000,
          1700000000.5
        ],
        "range": [
          0,
          1
        ]
      },
      "steps": [
        {
          "type": "query",
          "tickSpec": 5
        },
        {
          "type": "query",
          "ticks": 5
        },
        {
          "type": "query",
          "format": [
            1700000000.3,
            5
          ]
        }
      ],
      "expect": {
        "queries": [
          {
            "step": 0.1,
            "inv": 10,
            "decimals": 1
          },
          [
            1700000000,
            1700000000.1,
            1700000000.2,
            1700000000.3,
            1700000000.4,
            1700000000.5
          ],
          "22:13:20.3"
        ]
      }
    },
