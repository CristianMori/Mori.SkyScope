      "expect": {
        "queries": [
          [
            0,
            100000,
            200000,
            300000,
            400000,
            500000,
            600000,
            700000,
            800000,
            900000,
            1000000
          ],
          "300000"
        ]
      }
    },
    {
      "name": "degenerate domain maps to range start and has no ticks",
      "setup": {
        "kind": "linear",
        "domain": [
          5,
          5
        ],
        "range": [
          10,
          20
        ]
      },
      "steps": [
        {
          "type": "query",
          "scale": 5
        },
        {
          "type": "query",
          "scale": 7
        },
        {
          "type": "query",
          "ticks": 10
        },
        {
          "type": "query",
          "tickSpec": 10
        }
      ],
      "expect": {
        "queries": [
          10,
          10,
          [],
          {
            "step": 0,
            "inv": 0,
            "decimals": 0
          }
        ]
      }
    },
    {
      "name": "reversed domain still yields ascending ticks",
      "setup": {
        "kind": "linear",
        "domain": [
          100,
          0
        ],
        "range": [
          0,
          500
        ]
      },
      "steps": [
        {
          "type": "query",
          "scale": 25
        },
