{
  "component": "scene-controller",
  "cases": [
    {
      "name": "pan tool: drag pans, wheel zooms about the pointer, shift-drag box zooms",
      "setup": {
        "width": 200,
        "height": 200,
        "options": {
          "camera": {
            "centerX": 5,
            "centerY": 5,
            "zoom": 20
          }
        }
      },
      "steps": [
        {
          "type": "event",
          "event": {
            "type": "pointerdown",
            "x": 50,
            "y": 50,
            "button": 0
          }
        },
        {
          "type": "event",
          "event": {
            "type": "pointermove",
            "x": 70,
            "y": 60
          }
        },
        {
          "type": "event",
          "event": {
            "type": "pointerup",
            "x": 70,
            "y": 60,
            "button": 0
          }
        },
        {
          "type": "query",
          "camera": true
        },
        {
          "type": "event",
          "event": {
            "type": "wheel",
            "x": 100,
            "y": 100,
            "deltaY": -400
          }
        },
        {
          "type": "query",
          "camera": true
        },
        {
          "type": "event",
          "event": {
            "type": "pointerdown",
            "x": 60,
            "y": 60,
            "button": 0,
            "modifiers": {
              "shift": true
            }
          }
        },
        {
          "type": "event",
          "event": {
            "type": "pointermove",
            "x": 140,
            "y": 140,
            "modifiers": {
              "shift": true
            }
          }
        },
        {
          "type": "query",
          "boxPreview": true
        },
        {
          "type": "event",
          "event": {
            "type": "pointerup",
            "x": 140,
            "y": 140,
            "button": 0,
            "modifiers": {
              "shift": true
            }
          }
        },
        {
          "type": "query",
          "boxPreview": true
        },
        {
          "type": "query",
          "camera": true
        }
      ],
      "expect": {
        "queries": [
          false,
          true,
          false,
          {
            "centerX": 4,
            "centerY": 5.5,
            "zoom": 20,
            "rotation": 0
          },
          true,
          {
            "centerX": 4,
            "centerY": 5.5,
            "zoom": 40,
            "rotation": 0
          },
          false,
          true,
          {
            "x": 60,
            "y": 60,
            "w": 80,
            "h": 80
          },
          true,
          null,
          {
            "centerX": 4,
            "centerY": 5.5,
            "zoom": 100,
            "rotation": 0
          }
        ]
      }
    },
