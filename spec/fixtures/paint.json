{
  "$schema": "../fixture.schema.json",
  "component": "paint",
  "description": "RecordingPainter parity: every primitive records the same resolved op in both cores (defaults filled, numbers rounded to 3 decimals).",
  "cases": [
    { "name": "primitives with defaults resolved",
      "setup": { "width": 200, "height": 100 },
      "steps": [
        { "type": "clear" },
        { "type": "line", "x1": 0, "y1": 0.12345, "x2": 10, "y2": 10, "stroke": { "color": "#ff0000" } },
        { "type": "polyline", "points": [0, 0, 1, 1, 2, 0.5, 3, 4], "stroke": { "color": "#00f", "width": 2, "dash": [4, 2], "cap": "round", "join": "bevel", "opacity": 0.5 }, "offset": 2, "count": 2 },
        { "type": "polygon", "points": [0, 0, 10, 0, 5, 5], "fill": { "color": "rgba(0,0,0,0.5)" } },
        { "type": "rect", "x": 1, "y": 2, "w": 3, "h": 4, "fill": { "color": "#fff", "opacity": 0.25 }, "stroke": { "color": "#000" }, "radius": 1.5 },
        { "type": "circle", "cx": 5, "cy": 5, "r": 2.5, "stroke": { "color": "#0f0" } },
        { "type": "arc", "cx": 5, "cy": 5, "r": 4, "start": 0, "end": 3.14159265, "stroke": { "color": "#0f0" } },
        { "type": "sector", "cx": 5, "cy": 5, "inner": 2, "outer": 4, "start": -1.5708, "end": 1.5708, "fill": { "color": "#123456" } },
        { "type": "text", "text": "12.5", "x": 10, "y": 20, "style": { "color": "#333", "size": 14, "weight": "bold", "align": "center", "baseline": "middle", "rotation": -1.5707963 } },
        { "type": "measure", "text": "hello", "style": { "color": "#000" } },
        { "type": "measure", "text": "hi", "style": { "color": "#000", "size": 20 } }
      ],
      "expect": {
        "ops": [
          { "op": "clear", "color": null },
          { "op": "line", "x1": 0, "y1": 0.123, "x2": 10, "y2": 10, "stroke": { "color": "#ff0000", "width": 1, "dash": null, "cap": "butt", "join": "miter", "opacity": 1 } },
          { "op": "polyline", "points": [1, 1, 2, 0.5], "stroke": { "color": "#00f", "width": 2, "dash": [4, 2], "cap": "round", "join": "bevel", "opacity": 0.5 } },
          { "op": "polygon", "points": [0, 0, 10, 0, 5, 5], "fill": { "color": "rgba(0,0,0,0.5)", "opacity": 1 }, "stroke": null },
          { "op": "rect", "x": 1, "y": 2, "w": 3, "h": 4, "radius": 1.5, "fill": { "color": "#fff", "opacity": 0.25 }, "stroke": { "color": "#000", "width": 1, "dash": null, "cap": "butt", "join": "miter", "opacity": 1 } },
          { "op": "circle", "cx": 5, "cy": 5, "r": 2.5, "fill": null, "stroke": { "color": "#0f0", "width": 1, "dash": null, "cap": "butt", "join": "miter", "opacity": 1 } },
          { "op": "arc", "cx": 5, "cy": 5, "r": 4, "start": 0, "end": 3.142, "stroke": { "color": "#0f0", "width": 1, "dash": null, "cap": "butt", "join": "miter", "opacity": 1 } },
          { "op": "sector", "cx": 5, "cy": 5, "inner": 2, "outer": 4, "start": -1.571, "end": 1.571, "fill": { "color": "#123456", "opacity": 1 }, "stroke": null },
          { "op": "text", "text": "12.5", "x": 10, "y": 20, "style": { "color": "#333", "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "size": 14, "weight": "bold", "align": "center", "baseline": "middle", "rotation": -1.5707963, "opacity": 1 } }
        ],
        "queries": [{ "width": 36, "height": 12 }, { "width": 24, "height": 20 }]
      } },

    { "name": "layers draw once, are reused, and redraw when dirty",
      "setup": { "width": 50, "height": 50 },
      "steps": [
        { "type": "layer", "key": "grid", "width": 20, "height": 10, "x": 1, "y": 2, "ops": [{ "type": "line", "x1": 0, "y1": 0, "x2": 20, "y2": 0, "stroke": { "color": "#ccc" } }] },
        { "type": "layer", "key": "grid", "width": 20, "height": 10, "x": 3, "y": 4, "ops": [{ "type": "clear", "color": "#fff" }] },
        { "type": "layer", "key": "grid", "width": 20, "height": 10, "x": 5, "y": 6, "dirty": true, "ops": [{ "type": "clear", "color": "#fff" }] }
      ],
      "expect": {
        "ops": [
          { "op": "layerDraw", "key": "grid", "width": 20, "height": 10, "ops": [{ "op": "line", "x1": 0, "y1": 0, "x2": 20, "y2": 0, "stroke": { "color": "#ccc", "width": 1, "dash": null, "cap": "butt", "join": "miter", "opacity": 1 } }] },
          { "op": "layer", "key": "grid", "x": 1, "y": 2 },
          { "op": "layer", "key": "grid", "x": 3, "y": 4 },
          { "op": "layerDraw", "key": "grid", "width": 20, "height": 10, "ops": [{ "op": "clear", "color": "#fff" }] },
          { "op": "layer", "key": "grid", "x": 5, "y": 6 }
        ]
      } }
  ]
}
