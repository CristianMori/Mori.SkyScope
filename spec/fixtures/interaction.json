{
  "$schema": "../fixture.schema.json",
  "component": "interaction",
  "description": "Gesture reducer: click vs drag, pan/box-zoom/cursor gestures, modifier overrides, wheel zoom, cancel keys.",
  "cases": [
    { "name": "hovering while idle",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "pointermove", "x": 5, "y": 6 }],
      "expect": { "phase": "idle", "effects": [{ "type": "hover", "x": 5, "y": 6 }] } },
    { "name": "press and release within the slop is a click",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0 }, { "type": "pointermove", "x": 12, "y": 11 }, { "type": "pointerup", "x": 12, "y": 11, "button": 0, "modifiers": { "ctrl": true } }],
      "expect": { "phase": "idle", "gesture": null, "effects": [{ "type": "click", "x": 12, "y": 11, "button": 0, "modifiers": { "shift": false, "ctrl": true, "alt": false } }] } },
    { "name": "pan drag emits deltas from the press point",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0 }, { "type": "pointermove", "x": 11, "y": 11 }, { "type": "pointermove", "x": 20, "y": 15 }, { "type": "pointermove", "x": 25, "y": 15 }, { "type": "pointerup", "x": 25, "y": 15, "button": 0 }],
      "expect": { "phase": "idle", "effects": [{ "type": "pan", "dx": 10, "dy": 5 }, { "type": "pan", "dx": 5, "dy": 0 }] } },
    { "name": "shift-drag box zooms",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0, "modifiers": { "shift": true } }, { "type": "pointermove", "x": 50, "y": 40 }, { "type": "pointerup", "x": 50, "y": 40, "button": 0 }],
      "expect": { "effects": [{ "type": "boxZoomPreview", "rect": { "x": 10, "y": 10, "w": 40, "h": 30 } }, { "type": "boxZoom", "rect": { "x": 10, "y": 10, "w": 40, "h": 30 } }] } },
    { "name": "a tiny box zoom is cancelled",
      "setup": { "tool": "boxZoom" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0 }, { "type": "pointermove", "x": 30, "y": 15 }, { "type": "pointerup", "x": 30, "y": 15, "button": 0 }],
      "expect": { "effects": [{ "type": "boxZoomPreview", "rect": { "x": 10, "y": 10, "w": 20, "h": 5 } }, { "type": "boxZoomCancel" }] } },
    { "name": "middle button pans regardless of tool",
      "setup": { "tool": "cursor" },
      "steps": [{ "type": "pointerdown", "x": 0, "y": 0, "button": 1 }, { "type": "pointermove", "x": 10, "y": 0 }],
      "expect": { "phase": "dragging", "gesture": "pan", "effects": [{ "type": "pan", "dx": 10, "dy": 0 }] } },
    { "name": "space + left button pans",
      "setup": { "tool": "select" },
      "steps": [{ "type": "keydown", "key": " " }, { "type": "pointerdown", "x": 0, "y": 0, "button": 0 }, { "type": "pointermove", "x": 10, "y": 0 }, { "type": "pointerup", "x": 10, "y": 0, "button": 0 }, { "type": "keyup", "key": " " }],
      "expect": { "spaceHeld": false, "effects": [{ "type": "pan", "dx": 10, "dy": 0 }] } },
    { "name": "cursor tool drags emit hover and drag, then dragEnd",
      "setup": { "tool": "cursor" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0 }, { "type": "pointermove", "x": 20, "y": 10 }, { "type": "pointerup", "x": 20, "y": 10, "button": 0 }],
      "expect": { "effects": [{ "type": "dragStart", "x": 10, "y": 10 }, { "type": "hover", "x": 20, "y": 10 }, { "type": "drag", "x": 20, "y": 10, "dx": 10, "dy": 0 }, { "type": "dragEnd", "x": 20, "y": 10 }] } },
    { "name": "wheel zooms by base^(-deltaY/divisor)",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "wheel", "x": 5, "y": 5, "deltaY": 400 }, { "type": "wheel", "x": 5, "y": 5, "deltaY": -400 }],
      "expect": { "effects": [{ "type": "zoom", "x": 5, "y": 5, "factor": 0.5 }, { "type": "zoom", "x": 5, "y": 5, "factor": 2 }] } },
    { "name": "escape cancels a box zoom in progress",
      "setup": { "tool": "boxZoom" },
      "steps": [{ "type": "pointerdown", "x": 10, "y": 10, "button": 0 }, { "type": "pointermove", "x": 50, "y": 50 }, { "type": "keydown", "key": "Escape" }, { "type": "pointerup", "x": 50, "y": 50, "button": 0 }],
      "expect": { "phase": "idle", "effects": [{ "type": "boxZoomPreview", "rect": { "x": 10, "y": 10, "w": 40, "h": 40 } }, { "type": "boxZoomCancel" }] } },
    { "name": "double click resets; cancel during a pan is silent",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "dblclick", "x": 1, "y": 1 }, { "type": "pointerdown", "x": 0, "y": 0, "button": 0 }, { "type": "pointermove", "x": 10, "y": 0 }, { "type": "pointercancel" }],
      "expect": { "phase": "idle", "effects": [{ "type": "reset" }, { "type": "pan", "dx": 10, "dy": 0 }] } },
    { "name": "right button never starts a gesture and never clicks",
      "setup": { "tool": "pan" },
      "steps": [{ "type": "pointerdown", "x": 0, "y": 0, "button": 2 }, { "type": "pointermove", "x": 30, "y": 0 }, { "type": "pointerup", "x": 30, "y": 0, "button": 2 }],
      "expect": { "effects": [] } }
  ]
}
