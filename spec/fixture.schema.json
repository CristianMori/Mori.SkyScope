{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mori.SkyScope behaviour fixture",
  "description": "A component's behaviour as data. Both cores (C# and TS) run every case: create(setup) -> step(...) -> snapshot, then each key in `expect` must deep-equal the snapshot's key.",
  "type": "object",
  "required": ["component", "cases"],
  "properties": {
    "component": { "type": "string", "description": "Driver name, e.g. \"field\"" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expect"],
        "properties": {
          "name": { "type": "string" },
          "setup": { "type": "object" },
          "steps": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } } },
          "expect": { "type": "object", "description": "Subset of the snapshot to assert" }
        }
      }
    }
  }
}
