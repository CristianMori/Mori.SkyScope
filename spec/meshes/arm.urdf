<?xml version="1.0"?>
<!-- fixture robot -->
<robot name="arm">
  <material name="steel"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="see-through"><color rgba="1 0 0 0.5"/></material>
  <link name="base_link">
    <visual name="plate"><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><box size="0.4 0.4 0.1"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="0 0 0.3"/><geometry><cylinder radius="0.05" length="0.4"/></geometry><material><color rgba="0 0 1 1"/></material></visual>
  </link>
  <link name="upper_arm">
    <visual><origin xyz="0.25 0 0" rpy="0 1.5707963 0"/><geometry><cylinder radius="0.04" length="0.5"/></geometry><material name="steel"/></visual>
  </link>
  <link name="forearm">
    <visual><origin xyz="0.2 0 0"/><geometry><mesh filename="package://arm/meshes/forearm.stl" scale="0.001 0.001 0.001"/></geometry><material name="see-through"/></visual>
    <visual><origin xyz="0.4 0 0"/><geometry><sphere radius="0.03"/></geometry></visual>
  </link>
  <link name="tool"/>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <joint name="elbow" type="continuous">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.5 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="slide" type="prismatic">
    <parent link="forearm"/><child link="tool"/>
    <origin xyz="0.4 0 0" rpy="0 0 1.5707963"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.1"/>
  </joint>
</robot>