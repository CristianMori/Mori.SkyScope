{
  "color": {
    "bg":      { "canvas": "{color.gray.50}", "surface": "{color.white}", "subtle": "{color.gray.100}", "muted": "{color.gray.200}", "overlay": "rgba(15, 23, 42, 0.45)" },
    "text":    { "primary": "{color.gray.900}", "secondary": "{color.gray.600}", "muted": "{color.gray.400}", "inverse": "{color.white}", "link": "{color.blue.600}" },
    "border":  { "default": "{color.gray.200}", "strong": "{color.gray.300}", "focus": "{color.blue.500}" },
    "primary": { "default": "{color.blue.600}", "hover": "{color.blue.700}", "active": "{color.blue.800}", "subtle": "{color.blue.50}", "subtleHover": "{color.blue.100}", "text": "{color.white}", "ring": "{color.blue.200}" },
    "danger":  { "default": "{color.red.600}", "hover": "{color.red.700}", "active": "{color.red.800}", "subtle": "{color.red.50}", "subtleHover": "{color.red.100}", "text": "{color.white}", "ring": "{color.red.200}" },
    "success": { "default": "{color.green.600}", "hover": "{color.green.700}", "active": "{color.green.800}", "subtle": "{color.green.50}", "text": "{color.white}" },
    "warning": { "default": "{color.amber.500}", "hover": "{color.amber.600}", "active": "{color.amber.700}", "subtle": "{color.amber.50}", "text": "{color.gray.900}" },
    "control": { "bg": "{color.white}", "bgHover": "{color.gray.50}", "bgDisabled": "{color.gray.100}", "border": "{color.gray.300}", "borderHover": "{color.gray.400}", "placeholder": "{color.gray.400}", "textDisabled": "{color.gray.400}" }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "md": "0 4px 12px rgba(15, 23, 42, 0.10), 0 1px 3px rgba(15, 23, 42, 0.06)",
    "lg": "0 12px 32px rgba(15, 23, 42, 0.16), 0 2px 6px rgba(15, 23, 42, 0.08)"
  },
  "focus": { "ring": "0 0 0 3px {color.primary.ring}", "ringDanger": "0 0 0 3px {color.danger.ring}" }
}
